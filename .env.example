# ==============================================================================
# Portalkeu - Template Variabel Lingkungan (.env.example)
# Salin file ini menjadi '.env' lalu isi nilainya sesuai kredensial Anda.
# ==============================================================================

# Supabase Database & Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
DATABASE_URL=postgresql://postgres:password@your-project.supabase.co:5432/postgres

# Google Sheets (Jika Digunakan)
NEXT_PUBLIC_NEW_SHEETS_URL=https://docs.google.com/spreadsheets/d/...

# Cloudflare R2 Storage (Penyimpanan Berkas/Foto/Lampiran)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-cloudflare-r2-access-key
R2_SECRET_ACCESS_KEY=your-cloudflare-r2-secret-key
R2_BUCKET_NAME=lampiran-aplikasi
R2_PUBLIC_DOMAIN=https://pub-your-id.r2.dev

# SMTP Email Notifikasi
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@ugm.ac.id
EMAIL_PASS=your-app-password
